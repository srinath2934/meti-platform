{
  "name": "meti-enterprise-platform",
  "version": "1.0.0",
  "private": true,
  "description": "METI: Modus Enterprise Talent Intelligence Platform (Full-Stack Monorepo)",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && .venv\\Scripts\\uvicorn.exe app.main:app --reload --port 8000",
    "build:frontend": "cd frontend && npm run build",
    "check:frontend": "cd frontend && npm run check",
    "test:backend": "cd backend && .venv\\Scripts\\pytest.exe",
    "test:frontend": "cd frontend && npm run check",
    "capture:local": "cd screenshot_runner && node local_capture.js",
    "capture:smartui": "cd screenshot_runner && npx smartui exec -- node capture.js"
  }
}
